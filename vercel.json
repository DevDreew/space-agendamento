{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "space-agendamento.vercel.app"
        }
      ],
      "destination": "https://dreewsolution.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/buscar",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/termos",
      "destination": "/termos.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/buscar",
      "destination": "/buscar.html"
    },
    {
      "source": "/painel",
      "destination": "/index.html"
    },
    {
      "source": "/:slug/painel",
      "destination": "/index.html"
    },
    {
      "source": "/:slug/:barbeiro",
      "destination": "/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/index.html"
    }
  ]
}